{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "slime-landing",
  "compatibility_date": "2026-08-02",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "slime.unvalley.me", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
