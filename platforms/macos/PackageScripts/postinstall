#!/bin/bash
set -eu

bundle_identifier="com.unvalley.inputmethod.Slime"
target_volume="${3:-/}"

case "$target_volume" in
  /|/Volumes/*) ;;
  *)
    echo "Refusing unexpected target volume: $target_volume" >&2
    exit 64
    ;;
esac

target="${target_volume%/}/Library/Input Methods/Slime.app"
if [[ -L "$target" || ! -d "$target" ]]; then
  echo "Installed input method is missing or is not a bundle: $target" >&2
  exit 65
fi

installed_identifier="$(
  /usr/bin/plutil -extract CFBundleIdentifier raw -o - \
    "$target/Contents/Info.plist" 2>/dev/null || true
)"
if [[ "$installed_identifier" != "$bundle_identifier" ]]; then
  echo "Installed bundle identifier is unexpected: $installed_identifier" >&2
  exit 65
fi

owner="$(/usr/bin/stat -f '%Su:%Sg' "$target")"
if [[ "$owner" != "root:wheel" ]]; then
  echo "Installed bundle owner is unexpected: $owner" >&2
  exit 65
fi
